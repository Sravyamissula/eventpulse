# ==============================================================================
# EventPulse - Environment Configuration Template
# Copy this file to .env and configure values before starting the application
# ==============================================================================

# Database Configuration (PostgreSQL 17)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/eventpulse
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password_here

# Spring Boot Server Port
PORT=8081

# JWT Authentication Secret (Must be a 256-bit+ / 32-byte secret key set via environment)
EVENTPULSE_JWT_SECRET=your_secure_256bit_jwt_secret_min_32_bytes_here

# AI Intelligence Service URL
EVENTPULSE_AI_SERVICE_URL=http://localhost:8000

# Optional Google Gemini API Key for LLM-driven webhook diagnostics
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8081
